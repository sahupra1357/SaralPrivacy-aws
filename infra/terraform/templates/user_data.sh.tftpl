#!/bin/bash
# Boot script for the compute_mode = "ec2" instance. Runs on every launch,
# including the replacement the ASG creates after a failure, so it must be
# idempotent and must never assume local state survived.
#
# Order matters: claim the Elastic IP first (public DNS already points at it),
# then fetch secrets, then start the stack. Caddy gets a certificate from
# Let's Encrypt on first boot and renews it by itself.
set -euxo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data) 2>&1

REGION="${aws_region}"
APP_DIR=/opt/app

# ── 1. Claim the Elastic IP ──────────────────────────────────────────────────
# Until this succeeds the instance has an ephemeral address and no traffic.
TOKEN=$(curl -sX PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
aws ec2 associate-address \
  --region "$REGION" \
  --instance-id "$INSTANCE_ID" \
  --allocation-id "${eip_alloc_id}" \
  --allow-reassociation

# ── 2. Packages ──────────────────────────────────────────────────────────────
dnf install -y docker amazon-cloudwatch-agent
install -d -m 0755 /usr/local/lib/docker/cli-plugins
COMPOSE_ARCH=$(uname -m)
curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$${COMPOSE_ARCH}" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
systemctl enable --now docker

# ── 3. Secrets → /opt/app/.env (root-only) ───────────────────────────────────
install -d -m 0750 "$APP_DIR"
APP_SECRET=$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "${app_secret_arn}" --query SecretString --output text)
DB_SECRET=$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "${db_secret_arn}" --query SecretString --output text)

{
  # Non-secret environment, rendered from Terraform locals.
%{ for k, v in backend_env ~}
  printf '%s=%s\n' "${k}" '${v}'
%{ endfor ~}
  # Database connection, from the RDS secret.
  echo "$DB_SECRET" | python3 -c 'import json,sys; s=json.load(sys.stdin); print(f"POSTGRES_SERVER={s[\"host\"]}\nPOSTGRES_PORT={s[\"port\"]}\nPOSTGRES_USER={s[\"username\"]}\nPOSTGRES_PASSWORD={s[\"password\"]}\nPOSTGRES_DB={s[\"dbname\"]}")'
  # Every key of the app secret.
  echo "$APP_SECRET" | python3 -c 'import json,sys; [print(f"{k}={v}") for k,v in json.load(sys.stdin).items()]'
} > "$APP_DIR/.env"
chmod 0600 "$APP_DIR/.env"

# Frontend-only env: the web container gets a narrow set (SECRET_KEY and
# CRON_SECRET come from the app secret, mirroring frontend_secret_keys).
{
%{ for k, v in frontend_env ~}
  printf '%s=%s\n' "${k}" '${v}'
%{ endfor ~}
  echo "$APP_SECRET" | python3 -c 'import json,sys; s=json.load(sys.stdin); [print(f"{k}={s.get(k,\"\")}") for k in ("SECRET_KEY","CRON_SECRET")]'
} > "$APP_DIR/.env.web"
chmod 0600 "$APP_DIR/.env.web"

# ── 4. Compose file ──────────────────────────────────────────────────────────
# api runs prestart (alembic upgrade head) before serving, exactly as on ECS.
# worker is the same image with the scheduler entrypoint. caddy terminates TLS.
cat > "$APP_DIR/docker-compose.yml" <<COMPOSE
name: saralprivacy
services:
  api:
    image: ${api_image}
    restart: always
    env_file: [.env]
    expose: ["${backend_port}"]
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:${backend_port}/api/v1/utils/health-check/"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 90s
    logging:
      driver: awslogs
      options:
        awslogs-region: "$REGION"
        awslogs-group: "${log_group}"
        awslogs-stream: api

  worker:
    image: ${api_image}
    restart: always
    env_file: [.env]
    command: python -m app.jobs
    depends_on:
      api: {condition: service_healthy}
    logging:
      driver: awslogs
      options:
        awslogs-region: "$REGION"
        awslogs-group: "${log_group}"
        awslogs-stream: worker

  web:
    image: ${web_image}
    restart: always
    env_file: [.env.web]
    environment:
      BACKEND_URL: "http://api:${backend_port}"
    expose: ["${container_port}"]
    depends_on:
      api: {condition: service_healthy}
    logging:
      driver: awslogs
      options:
        awslogs-region: "$REGION"
        awslogs-group: "${log_group}"
        awslogs-stream: web

  caddy:
    image: caddy:2-alpine
    restart: always
    ports: ["80:80", "443:443"]
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
    depends_on: [web]
    logging:
      driver: awslogs
      options:
        awslogs-region: "$REGION"
        awslogs-group: "${log_group}"
        awslogs-stream: caddy

volumes:
  caddy_data:
COMPOSE

# ── 5. Caddyfile ─────────────────────────────────────────────────────────────
# One vhost. With CloudFront enabled it serves origin.<domain> (CloudFront is
# the edge); without it, the apex and www directly.
cat > "$APP_DIR/Caddyfile" <<CADDY
{
  email ${acme_email}
}

${tls_domain}${ tls_domain == site_domain ? ", www.${site_domain}" : "" } {
  encode zstd gzip
  reverse_proxy web:${container_port} {
    header_up X-Forwarded-For {http.request.header.CloudFront-Viewer-Address}
  }
}
CADDY

# ── 6. CloudWatch agent (memory is not an EC2 metric by default) ─────────────
cat > /opt/aws/amazon-cloudwatch-agent/etc/config.json <<'CWAGENT'
{
  "metrics": {
    "append_dimensions": {"AutoScalingGroupName": "$${aws:AutoScalingGroupName}"},
    "aggregation_dimensions": [["AutoScalingGroupName"]],
    "metrics_collected": {
      "mem": {"measurement": [{"name": "mem_used_percent"}], "metrics_collection_interval": 60},
      "disk": {"measurement": [{"name": "used_percent"}], "resources": ["/"], "metrics_collection_interval": 300}
    }
  }
}
CWAGENT
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/config.json

# ── 7. Start ─────────────────────────────────────────────────────────────────
aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$(echo "${api_image}" | cut -d/ -f1)"
cd "$APP_DIR"
docker compose pull
docker compose up -d

# Redeploys: `aws ssm send-command` runs this unit, which pulls and restarts.
cat > /etc/systemd/system/app-deploy.service <<'UNIT'
[Unit]
Description=Pull the latest images and restart the stack
[Service]
Type=oneshot
WorkingDirectory=/opt/app
ExecStart=/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up -d
UNIT
systemctl daemon-reload

# Survive a reboot.
cat > /etc/systemd/system/app.service <<'UNIT'
[Unit]
Description=SaralPrivacy stack
Requires=docker.service
After=docker.service
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/app
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable app.service
