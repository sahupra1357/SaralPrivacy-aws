# Copy to backend.hcl (git-ignored) and run: terraform init -backend-config=backend.hcl
# Bootstrap the bucket once (Terraform >= 1.10 uses S3-native locking, no DynamoDB needed):
#   aws s3api create-bucket --bucket saralprivacy-tfstate --region ap-south-1 \
#     --create-bucket-configuration LocationConstraint=ap-south-1
#   aws s3api put-bucket-versioning --bucket saralprivacy-tfstate \
#     --versioning-configuration Status=Enabled
#   aws s3api put-public-access-block --bucket saralprivacy-tfstate \
#     --public-access-block-configuration BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
bucket       = "saralprivacy-tfstate"
key          = "prod/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
use_lockfile = true
