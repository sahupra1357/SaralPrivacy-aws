# Copy to terraform.tfvars (git-ignored). Everything has a sane default; these are the
# values you are most likely to change.

# ── Compute: "ec2" (one docker-compose box in an ASG, ~48/mo) or "fargate"
# (three ECS services behind an ALB, ~170/mo). Everything else — VPC, RDS, S3,
# ECR, secrets, DNS, CloudFront — is identical either way, so switching modes is
# this one line plus `terraform apply`. See docs/build/DEPLOY_RUNBOOK.md Part 4.
compute_mode = "ec2"

# compute_mode = "ec2" knobs (ignored in fargate mode)
ec2_instance_type  = "t4g.medium" # 2 vCPU / 4 GB Graviton — needs cpu_architecture = "ARM64"
cpu_architecture   = "ARM64"      # build images with --platform linux/arm64
ec2_root_volume_gb = 30           # the API image carries Chromium
# ec2_key_name           = ""     # empty = SSM Session Manager only (recommended)
# ec2_enable_health_check = true  # Route 53 check drives the alarm, not the failover

aws_region  = "ap-south-1"
domain_name = "saralprivacy.com"
environment = "prod"

# First apply: create the zone, then move the registrar's nameservers to the output
# `route53_nameservers`. If the domain already has a Route 53 zone:
# create_hosted_zone = false
# hosted_zone_id     = "Z0123456789ABCDEFGHIJ"
create_hosted_zone = true

# CloudFront in front of the ALB: supplies visitor city/country/region + real IP.
enable_cloudfront = true

# Cost knobs
# NAT is only used by the fargate path; the ec2 instance sits in a public subnet
# with its Elastic IP, so leave this false in ec2 mode (~USD 33/mo less).
enable_nat_gateway = true # false = tasks in public subnets, no NAT (~USD 35/mo less)

# Frontend (Next.js)
task_cpu      = 512
task_memory   = 1024
desired_count = 1
min_count     = 1
max_count     = 4

# Backend (FastAPI + Playwright PDFs) and worker (scheduled jobs)
backend_task_cpu    = 1024
backend_task_memory = 2048
backend_min_count   = 1
backend_max_count   = 4
worker_task_cpu     = 1024
worker_task_memory  = 2048

# Database
db_instance_class      = "db.t4g.micro"
db_multi_az            = false
db_deletion_protection = true

# Alerts
alarm_email = "you@example.com"

# CI/CD (GitHub OIDC)
github_repository    = "sahupra1357/SaralPrivacy-aws"
github_deploy_branch = "main"

# Extra non-secret backend/worker env (merged over locals.tf defaults)
app_env = {
  OUTREACH_DAILY_CAP = "50"
  ANTHROPIC_MODEL    = "claude-sonnet-4-6"
}

# Secrets: do NOT put them here. After the first apply run
#   aws secretsmanager put-secret-value --secret-id <app_secret_arn> --secret-string file://secrets.json
# where secrets.json contains every key in app_secret_keys (variables.tf).
# Resend SMTP: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASSWORD=<Resend API key>.
